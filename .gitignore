# ===== Python 环境 =====
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]

# ===== AI / agent 本地工具产物 =====
.agentcad/
**/.agentcad/
**/.claude/
# agentcad 版本快照目录（v1_xxx/ v2_xxx/ ... 内含 STEP/STL/preview）
**/v[0-9]*_*/

# ===== CAD / FEA / 仿真派生几何（可由 *.py 重新生成） =====
*.step
*.stl
*.glb
*.msh
*.inp
*.frd
*.dat
*.sta
*.log

# ===== 本地工具与依赖 =====
.tools/
**/.tools/
node_modules/

# ===== 读图工作区（从 ref/ 原图裁切的派生图，不是源） =====
ref/.work/
simulation/electronics/.work/

# ===== mechanical 生成目录（精确规则：只忽略二进制/中间产物，保留文档配图与元数据） =====
# 保留：build/render/*.png、build/params.json、build/assembly/meta.json、build/verify_report.json
mechanical/*/build/parts/
mechanical/*/build/assembly/*.png
mechanical/legacy/build/
mechanical/hy928d/build/*.step
mechanical/hy928d/build/*.stl
mechanical/hy928d/build/*.msh

# ===== agentcad init 在子项目写入的 guide（不入库；根目录 AGENTS.md 是项目约定，保留） =====
mechanical/lumen/AGENTS.md
mechanical/square_v1/AGENTS.md

# ===== OS / 编辑器 =====
.DS_Store
**/.DS_Store
Thumbs.db

# ===== 固件构建产物 =====
firmware/esp32/build/
firmware/esp32/sdkconfig
firmware/esp32/sdkconfig.old
firmware/esp32/managed_components/
tests/firmware/build/
**/*.bin
**/*.elf
**/*.map

# ===== 渲染场景（体积大；脚本/配置/输出图入库） =====
render/**/*.blend
render/**/*.blend1

# ===== FEA VTK 导出 =====
*.vtp
*.vtu

# ===== PCB 交换文件（DSN/SES 可留，SVG/PDF 图入库） =====
*.dsn
*.ses

# ===== appearance 印花/多材料产物（大二进制；脚本可再生成，见 appearance/README.md） =====
appearance/.work/
appearance/build/print/*/*.3mf
appearance/build/print/*/filament_*.stl
appearance/build/3mf/*.3mf
appearance/render/**/*.blend
appearance/render/**/*.blend1
appearance/render/**/__pycache__/
appearance/build/render/

# ===== 打印交付（render/print/appearance）：STL/3MF 大文件由 run_print_stage.sh 再生成 =====
render/print/appearance/**/stl/
render/print/appearance/**/*.3mf
render/print/stl/**/*.stl
render/print/stl/**/*.3mf
