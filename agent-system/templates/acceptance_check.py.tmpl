#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""acceptance_check.py — {{PROJECT_TITLE}} project-level acceptance skeleton.

Generic, dependency-free skeleton generated by agent-system. Extend the
`checks` section with project-specific gates (mechanical 21, ERC/DRC, DFM,
firmware host tests, appearance 129, ...) and keep the output machine-readable.

Usage:
    python3 scripts/acceptance_check.py             # run, write build/ACCEPTANCE.{json,md}
    python3 scripts/acceptance_check.py --dry-run   # print only, no write
    python3 scripts/acceptance_check.py --json      # JSON on stdout

Exit code: 0 iff every check passes.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

PROJECT = "{{PROJECT_TITLE}}"
ROOT = Path(__file__).resolve().parents[1]
OUT_JSON = ROOT / "build" / "ACCEPTANCE.json"
OUT_MD = ROOT / "build" / "ACCEPTANCE.md"

CHECKS: list[dict] = []


def check(group: str, name: str, ok: bool, detail: str = "") -> None:
    CHECKS.append({"group": group, "name": name, "ok": bool(ok), "detail": detail})


def exists(rel: str, min_bytes: int = 1) -> tuple[bool, str]:
    p = ROOT / rel
    if not p.exists():
        return False, f"missing: {rel}"
    size = p.stat().st_size
    return size >= min_bytes, f"{rel} ({size} B)"


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="Project acceptance skeleton")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    # ---- 1. docs / governance -------------------------------------------
    ok, d = exists("AGENTS.md", 200)
    check("docs", "AGENTS.md exists", ok, d)
    ok, d = exists("docs/01_AI_Hardware_Engineering_Pipeline.md", 200)
    check("docs", "pipeline doc exists", ok, d)
    ok, d = exists("docs/02_PRD.md", 200)
    check("docs", "PRD exists", ok, d)
    ok, d = exists("docs/HANDOFF.md", 200)
    check("docs", "HANDOFF exists", ok, d)
    ok, d = exists("TASK_BOARD.md", 100)
    check("docs", "task board exists", ok, d)

    # ---- 2. config / requirements ---------------------------------------
    ok, d = exists("requirements.yaml", 50)
    check("config", "requirements.yaml exists", ok, d)
    ok, d = exists("config/mechanical_params.yaml", 50)
    check("config", "mechanical params exists", ok, d)

    # requirements.yaml must parse if PyYAML is available
    try:
        import yaml  # type: ignore
        req = yaml.safe_load((ROOT / "requirements.yaml").read_text(encoding="utf-8"))
        check("config", "requirements.yaml parses", isinstance(req, dict),
              f"{len(req)} keys")
    except ImportError:
        check("config", "requirements.yaml parses", True, "PyYAML unavailable (skipped)")
    except Exception as exc:  # noqa: BLE001
        check("config", "requirements.yaml parses", False, str(exc))

    # ---- 3. layout -------------------------------------------------------
    for d in ("mechanical", "electronics", "firmware", "simulation", "tests", "build"):
        check("layout", f"dir {d}/ exists", (ROOT / d).is_dir(), str(ROOT / d))

    # ---- 4. project-specific gates (extend me) --------------------------
    # Examples:
    #   ok, d = exists("mechanical/<version>/build/verify_report.json")
    #   check("mechanical", "verify report exists", ok, d)
    #   if ok:
    #       rep = json.loads((ROOT / ...).read_text())
    #       check("mechanical", "mechanical self-check 21/21", rep.get("ok") is True)
    #
    #   ok, d = exists("electronics/kicad/build/DRC.rpt")
    #   check("electronics", "DRC report exists", ok, d)
    check("gates", "no project-specific gates added yet", True,
          "extend this skeleton per project")

    # ---- report ----------------------------------------------------------
    total = len(CHECKS)
    passed = sum(1 for c in CHECKS if c["ok"])
    failed = [c for c in CHECKS if not c["ok"]]
    groups: dict[str, list[int]] = {}
    for c in CHECKS:
        g = groups.setdefault(c["group"], [0, 0])
        g[0 if c["ok"] else 1] += 1

    result = {
        "project": PROJECT,
        "total": total,
        "passed": passed,
        "failed": len(failed),
        "ok": not failed,
        "groups": {k: {"pass": v[0], "fail": v[1]} for k, v in groups.items()},
        "checks": CHECKS,
    }

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(f"{PROJECT} acceptance: {passed}/{total} PASS")
        for g, v in groups.items():
            print(f"  {g:10s} {v[0]}/{v[0] + v[1]}")
        for c in failed:
            print(f"  FAIL {c['group']}/{c['name']}: {c['detail']}")

    if not args.dry_run:
        OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
        OUT_JSON.write_text(json.dumps(result, indent=2, ensure_ascii=False),
                            encoding="utf-8")
        lines = [f"# {PROJECT} — ACCEPTANCE", "",
                 f"**{passed}/{total} PASS**", ""]
        for c in CHECKS:
            mark = "PASS" if c["ok"] else "FAIL"
            lines.append(f"- [{mark}] `{c['group']}/{c['name']}` — {c['detail']}")
        OUT_MD.write_text("\n".join(lines) + "\n", encoding="utf-8")
        if not args.json:
            print(f"wrote {OUT_JSON.relative_to(ROOT)} and {OUT_MD.relative_to(ROOT)}")

    return 0 if not failed else 1


if __name__ == "__main__":
    sys.exit(main())
